NODE_ENV=development
HOST=127.0.0.1
PORT=8080
DATABASE_PATH=./data/kiosk.db
STORAGE_PATH=./storage
COOKIE_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
SESSION_TTL_HOURS=8
MAX_UPLOAD_BYTES=524288000
KIOSK_DEVICE_ID=kiosk-main
KIOSK_DEVICE_TOKEN=replace-with-a-high-entropy-device-token
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-me-before-running-bootstrap
