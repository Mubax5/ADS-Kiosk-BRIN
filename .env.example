NODE_ENV=development
HOST=127.0.0.1
PORT=8080
DATABASE_PATH=./data/kiosk.db
STORAGE_PATH=./storage
ADMIN_DIST_PATH=./apps/admin/dist
KIOSK_DIST_PATH=./apps/kiosk/dist
BACKUP_PATH=./backups
LOG_PATH=./logs
RUN_LOCK_PATH=./data/server.lock
LOG_LEVEL=info
COOKIE_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
SESSION_TTL_HOURS=8
MAX_UPLOAD_BYTES=524288000
KIOSK_DEVICE_ID=kiosk-main
KIOSK_DEVICE_TOKEN=replace-with-the-same-high-entropy-token-used-by-the-kiosk-build
VITE_KIOSK_DEVICE_TOKEN=replace-with-the-same-high-entropy-token-used-by-the-server
VITE_KIOSK_SOFTWARE_VERSION=0.1.0
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-me-before-running-bootstrap
